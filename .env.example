# WADJET configuration — all values have sane defaults for local development.

# HTTP
WADJET_PORT=8080
WADJET_ENV=development

# Local development convenience (used by `make dev`): unauthenticated
# requests are served as the bootstrap admin. Requires WADJET_ENV to be
# exactly "development" AND this flag explicitly set to 1; the server
# refuses to boot on any other combination. While active, the API binds
# 127.0.0.1 only (override: WADJET_DEV_BIND_ALL=1). NEVER enable outside
# a local development machine.
# WADJET_DEV_NO_LOGIN=1

# Database
DATABASE_URL=postgres://wadjet:***@127.0.0.1:5432/wadjet?sslmode=disable

# Auth
# Secret used to sign session tokens. Generate with: openssl rand -hex 32
WADJET_SESSION_SECRET=dev-se…e-me
# Bootstrap admin account (created on first boot if no users exist)
WADJET_ADMIN_EMAIL=admin@wadjet.local
WADJET_ADMIN_PASSWORD=***

# Storage (persistent filesystem)
WADJET_REPORT_DIR=./data/reports
WADJET_RAW_OUTPUT_DIR=./data/raw
WADJET_SCAN_WORKDIR=./data/scanwork

# Scanner execution
WADJET_SCANNER_CONFIG_DIR=./configs/scanners
WADJET_SCAN_CONCURRENCY=4
WADJET_SCAN_TIMEOUT=1800

# Deploy behind a reverse proxy (nginx/Traefik)? Then set to 1 so the login
# rate limiter keys on X-Forwarded-For. Leave unset otherwise: without it
# only the socket IP is trusted (XFF is client-controlled and spoofable).
# WADJET_TRUST_PROXY=1

# Production hardening: with WADJET_ENV=production the server refuses to
# start while WADJET_SESSION_SECRET or WADJET_ADMIN_PASSWORD still hold their
# shipped defaults, and session cookies get the Secure flag.
